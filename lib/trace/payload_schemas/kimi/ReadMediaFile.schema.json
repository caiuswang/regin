{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReadMediaFile PostToolUse payload (Kimi)",
  "type": "object",
  "required": ["tool_name", "tool_input"],
  "additionalProperties": true,
  "properties": {
    "tool_name": {
      "const": "ReadMediaFile"
    },
    "tool_input": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "path": {
          "type": "string"
        },
        "file_path": {
          "type": "string"
        }
      }
    },
    "tool_response": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
